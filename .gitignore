# Ignore everything by default.
/*

# Then allow ONLY the production library + module definition.
!/.gitignore
!/README.md
!/go.mod
!/go.sum
!/core/
!/tests/
!/tests/**

# Keep the memory-flood audit and its bounded reproduction harness.
!/docs/
/docs/*
!/docs/MEMORY_FLOOD_AUDIT.md
!/cmd/
/cmd/*
!/cmd/memflood/
/cmd/memflood/*
!/cmd/memflood/main.go

# Within core/, keep build artifacts and local junk out.
core/*.exe
core/*.test
core/*.out
core/*.prof
